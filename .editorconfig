# The editor-side half of the line-ending story: .gitattributes fixes files on their way into git,
# this fixes them on save. VS Code needs the "EditorConfig for VS Code" extension to apply it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown — trimming them silently reflows text.
[*.md]
trim_trailing_whitespace = false
