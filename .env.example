# One deployment serves one reader — see
# docs/decisions/0041-one-deployment-one-reader.md. Everything below is either
# per-person (a key, a bot, a CV) or per-machine (a port). Nothing here is a
# tuning knob: the models, the thresholds and the budgets live in code, where a
# measurement can be recorded beside the number it produced.
#
# Required to boot: OPENROUTER_API_KEY.
# Required for a bot to answer: AVA_TELEGRAM_USER_ID + one bot token.

# ─── Keys ──────────────────────────────────────────────────────────────────────
# A single OpenRouter key covers every model this repo calls.
OPENROUTER_API_KEY=
# Optional, and the only optional key. Newy's `generateImage` tool, the one call
# that does not go through OpenRouter. Leave it empty and she is built without
# the tool rather than with one that fails when asked.
REPLICATE_API_KEY=

# ─── Telegram ──────────────────────────────────────────────────────────────────
# YOUR numeric Telegram user id. One value, and it does three jobs: it is the
# allowlist for every bot, and — because a private chat's `chat_id` IS the user
# id — it is also where each bot's scheduled digests are pushed.
#
# @userinfobot tells you what it is. Not an @username: every API call would then
# fail with "chat not found" one layer further down, so the parser rejects it up
# front.
#
# Without this, a bot with a token would accept messages from anyone who found
# it — so the adapter refuses to start rather than opening the bot.
AVA_TELEGRAM_USER_ID=

# One bot per agent, each with its own token — ADR-0023. Two adapters sharing a
# token share a `getUpdates` offset and eat each other's messages, so these must
# be two different @BotFather bots. They are still two separate conversations in
# the client even though the user id above is the same for both.
#
# Newy (news). From @BotFather.
NEWY_TELEGRAM_BOT_TOKEN=
# Joob (jobs + leads). Optional: with no token Joob is constructed with no
# channel at all — visible in Studio, polling nothing, publishing nothing,
# costing nothing.
JOOB_TELEGRAM_BOT_TOKEN=

# Threaded Mode is per bot and is a manual @BotFather toggle no API can set. A
# new bot needs its own: Bot Settings → Threads Settings → Threaded Mode.
# `pnpm telegram:check` reports it for both.

# ─── Portfolio (Joob's CV source) ──────────────────────────────────────────────
# The CV Joob scores every job posting against, and the portfolio the leads
# pipeline pitches. Fetched fresh at the start of each run and cached nowhere:
# update your portfolio and the next run uses it — no command, no redeploy.
#
# Must return markdown — `text/markdown` or `text/plain`. Anything else is
# rejected loudly, because a deployment-protection wall answers 200 with an HTML
# login page and that would otherwise be scored as if it were your CV.
# `pnpm portfolio:check` fetches it and shows you exactly what came back.
PORTFOLIO_FEED_URL=
# Optional. Sent as `Authorization: Bearer …`. Needed when the endpoint carries
# more than your public site does, which is the usual reason to have one.
PORTFOLIO_FEED_TOKEN=

# ─── Scheduling ────────────────────────────────────────────────────────────────
# IANA zone for digest fire times. Set explicitly so they don't follow server
# locale — this is per reader, not per machine.
AGENT_TIMEZONE=Europe/Paris

# ─── Data ──────────────────────────────────────────────────────────────────────
# Mastra memory/workflows/scores + the app's own tables (feeds, items, feedback).
# Leave both empty for the defaults: a file under .data/ locally, and the
# `ava-data` volume in Docker (docker-compose.yml overrides the path).
#
# Set it to a Turso URL (libsql://…) to run stateless with no volume at all,
# which is the easier shape when you run one deployment per reader.
AVA_DATA_DB_URL=
# Only needed for remote libsql/Turso URLs.
AVA_DATA_DB_AUTH_TOKEN=

# ─── This machine ──────────────────────────────────────────────────────────────
# Port Mastra listens on locally: `pnpm dev` (Studio) and `pnpm start`. Empty
# means the first free port from 4111 upward. Terminal scripts follow it rather
# than assuming 4111.
PORT=
# The host port Docker publishes Studio on, loopback-only. Its own variable
# because it is the one thing two deployments on one box collide over — nothing
# reaches the container from the network either way (invariant 1).
AVA_HOST_PORT=4111

# ─── Rarely set ────────────────────────────────────────────────────────────────
# Everything below has a working default in code. Set one only to answer a
# specific problem.
#
# Per-bot chat override. Unset in an ordinary deployment: each bot pushes to your
# DM. Set it to a `-100…` supergroup id to run a bot in a forum group instead —
# a group id is nobody's user id, so it is the one thing that cannot be derived
# from AVA_TELEGRAM_USER_ID.
# NEWY_TELEGRAM_CHAT_ID=
# JOOB_TELEGRAM_CHAT_ID=
#
# Traces are a dev-time artifact read in Studio while tuning; the default is a
# local file, and Docker points it into the volume.
# AVA_TRACES_DB_URL=
#
# Where the Drizzle migrations live. Relative paths anchor to the project root,
# NOT to the working directory. Docker sets an absolute one. Leave it alone
# unless you are changing the image layout.
# AVA_MIGRATIONS_DIR=
#
# Only for a server this machine cannot reach at localhost:PORT — another host,
# or a container being driven from outside. Overrides the whole URL, port
# included.
# AVA_DEV_SERVER_URL=
#
# Every model is chosen in src/config/env.ts, with the measurement that chose it
# written beside it. They are not in this file on purpose: a model id copied
# into a .env in January is what a deployment is still running in June, and the
# reasoning stayed in the repo it was copied out of. Override one here only to
# run an experiment, and record the result in env.ts if it wins.
# AVA_MODEL_ORCHESTRATOR=
# AVA_MODEL_RSS_RANKER=
# AVA_MODEL_RSS_SUMMARIZER=
# AVA_MODEL_MEMORY_REVIEWER=
# AVA_MODEL_TRANSLATOR=
# AVA_MODEL_SUMMARIZER=
# AVA_MODEL_BEAT_NAMER=
# AVA_MODEL_BEAT_SCOUT=
# AVA_MODEL_JOB_TARGETER=
# AVA_MODEL_JOB_SCOUT=
# AVA_MODEL_JOB_SCORER=
# AVA_MODEL_JOB_WRITER=
# AVA_MODEL_LEAD_TARGETER=
# AVA_MODEL_LEAD_SCORER=
# AVA_MODEL_LEAD_SCOUT=
# AVA_MODEL_LEAD_VISION=
# AVA_MODEL_LEAD_WRITER=
