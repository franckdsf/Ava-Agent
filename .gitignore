# Dependencies
node_modules/

# Secrets. Every .env* is ignored except the example — a per-reader deployment
# means several of them (deploy/alice.env, .env.bak…), and listing them one by
# one is how the second one gets committed (ADR-0041).
.env
.env.*
!.env.example
deploy/

# IDE local-history extensions snapshot .env verbatim — never commit these
.history/

# Build output
dist/
.mastra/

# Local databases (data + traces). Migrations in drizzle/ ARE committed.
.data/

# Pre-migration volume snapshots written by scripts/deploy.sh. They are a copy
# of the reader's database, which is the one thing in here that must not travel.
backups/

# Editor / OS
.DS_Store
*.log
