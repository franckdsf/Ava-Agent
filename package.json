{
  "name": "ava-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Telegram AI orchestrator that curates RSS news via category-expert sub-agents",
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "bench": "tsx --env-file=.env scripts/bench.ts",
    "build": "mastra build",
    "catchup:check": "tsx --env-file=.env scripts/check-catchup.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dev": "mastra dev",
    "discovery:check": "tsx --env-file=.env scripts/check-discovery.ts",
    "feeds:check": "tsx --env-file=.env scripts/check-feeds.ts",
    "finder:check": "tsx scripts/check-finder.ts",
    "jobs:check": "tsx --env-file=.env scripts/check-job-sources.ts",
    "leads:check": "vitest run lead",
    "leads:yield": "tsx --env-file=.env scripts/check-lead-yield.ts",
    "leadscout:check": "tsx --env-file=.env scripts/check-lead-scout.ts",
    "portfolio:check": "tsx --env-file=.env scripts/check-portfolio.ts",
    "prepare": "node scripts/prepare.mjs",
    "review:check": "tsx --env-file=.env scripts/check-feed-review.ts",
    "rssfinder:check": "tsx scripts/check-rssfinder.ts",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "sonar:check": "tsx --env-file=.env scripts/check-sonar.ts",
    "start": "node .mastra/output/index.mjs",
    "telegram:check": "tsx --env-file=.env scripts/check-telegram.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm verify:rules && pnpm test",
    "verify:bots": "node scripts/checks/c7-bot-agnostic.mjs",
    "verify:cadence": "node scripts/checks/c8-one-cadence.mjs",
    "verify:catch": "node scripts/checks/c4-silent-catch.mjs",
    "verify:models": "node scripts/checks/c5-model-boundary.mjs",
    "verify:data": "node scripts/checks/c6-data-access.mjs",
    "verify:cycles": "node scripts/checks/c2-import-cycles.mjs",
    "verify:docs": "node scripts/checks/c1-doc-integrity.mjs",
    "verify:paths": "node scripts/checks/c3-anchored-paths.mjs",
    "verify:invariants": "node scripts/checks/c9-invariant-text.mjs",
    "verify:rules": "pnpm verify:docs && pnpm verify:cycles && pnpm verify:paths && pnpm verify:catch && pnpm verify:models && pnpm verify:data && pnpm verify:bots && pnpm verify:cadence && pnpm verify:invariants",
    "workflow:run": "tsx --env-file-if-exists=.env scripts/run-workflow.ts",
    "youtube:check": "tsx scripts/check-youtube.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "mastra": "^1.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@chat-adapter/telegram": "^4.35.0",
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.52.1",
    "@mastra/libsql": "^1.17.0",
    "@mastra/memory": "^1.23.1",
    "drizzle-orm": "^0.45.2",
    "replicate": "^1.4.0",
    "rss-parser": "^3.13.0",
    "youtube-caption-extractor": "^1.10.2",
    "zod": "^4.4.3"
  }
}
